# -------------------------------------------------------------
# Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to .env.development or .env.production as needed.

# Target database provider: 'sqlite' (development) or 'mysql' (production)
DATABASE_PROVIDER=sqlite

# =============================================================
# Option A: SQLite (Recommended for Development)
# =============================================================
# Uses a local file-based database. No external database server required.
DATABASE_URL="file:./dev.db"

# =============================================================
# Option B: MySQL (Recommended for Production)
# =============================================================
# Provide your MySQL server connection details.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quizrand_user
DB_PASSWORD=your_secure_password
DB_NAME=quizrand_production

# MySQL Prisma connection string
# DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=prefer"
